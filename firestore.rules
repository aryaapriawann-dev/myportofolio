rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reviews — siapa saja boleh baca & tulis (form komentar publik)
    match /reviews/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'text', 'stars', 'createdAt'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 100
                   && request.resource.data.text is string
                   && request.resource.data.text.size() > 0
                   && request.resource.data.text.size() <= 1000
                   && request.resource.data.stars is int
                   && request.resource.data.stars >= 1
                   && request.resource.data.stars <= 5;
      allow update, delete: if false; // hanya admin yang bisa hapus (via console)
    }

    // Projects, certificates, timeline — baca publik, tulis hanya dari app
    match /projects/{docId} {
      allow read: if true;
      allow write: if true; // admin panel tidak pakai auth, jadi allow all
    }

    match /certificates/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /timeline/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /contacts/{docId} {
      allow read: if false;
      allow create: if true;
    }
  }
}
